<!-- Group of Permissions for Direction users -->
<tryton>
    <data>
        <!-- Create the user group's directionEntities -->
        <record model="res.group" id="group_akademy_direc">
            <field name="name">Akademy Direction</field>
        </record>       

        <record model="ir.ui.menu-res.group" 
            id="akademy_party-group_akademy_direc">
            <field name="menu" ref="akademy_party"/>
            <field name="group" ref="group_akademy_direc"/>
        </record>

        <record model="ir.model.access" 
            id="access_akademy_entities-group_akademy_direc">
            <field name="model">party.party</field>
            <field name="group" ref="group_akademy_direc"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        
        <record model="ir.rule.group" 
            id="rule_group_akademy_entities-group_akademy_direc">
            <field name="name">Entities</field>
            <field name="model">party.party</field>
            <field name="global_p" eval="False"/>
            <field name="default_p" eval="False"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.rule.group-res.group" 
            id="res_group_akademy_entities-group_akademy_direc">
            <field name="rule_group" ref="rule_group_akademy_entities-group_akademy_direc"/>
            <field name="group" ref="group_akademy_direc"/>
        </record>        
    </data>
</tryton>